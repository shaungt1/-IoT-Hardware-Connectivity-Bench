{
  "name": "iot-hardware-connectivity-bench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "verify:bundle": "node scripts/verify-bundle.mjs",
