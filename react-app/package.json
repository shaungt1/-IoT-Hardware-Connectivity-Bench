    "verify:phase-one": "node scripts/verify-phase-one.mjs",
    "verify:soak": "node scripts/verify-camera-soak.mjs",
    "verify:prototype": "node scripts/verify-prototype-studio.mjs",
    "verify:workspaces": "node scripts/verify-workspaces.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
